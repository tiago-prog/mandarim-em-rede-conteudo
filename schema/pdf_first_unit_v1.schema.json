{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mandarim-em-rede/pdf-first-unit-v1",
  "title": "Mandarim em Rede — Unidade PDF-first v1",
  "type": "object",
  "required": ["schema_version", "produto", "unidade"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "produto": {"type": "string", "minLength": 1},
    "unidade": {
      "type": "object",
      "required": ["codigo", "titulo", "nivel", "status", "objetivo_comunicativo", "resultado_minimo", "situacao_principal", "estruturas", "sequencia", "pacotes"],
      "properties": {
        "codigo": {"type": "string", "pattern": "^[A-Z][0-9]{2}$"},
        "titulo": {"type": "string", "minLength": 1},
        "nivel": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "revisao_linguistica", "revisao_visual", "piloto", "aprovado", "publicado"]},
        "objetivo_comunicativo": {"type": "string", "minLength": 1},
        "resultado_minimo": {"type": "string", "minLength": 1},
        "situacao_principal": {"type": "string", "minLength": 1},
        "estruturas": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["funcao", "mandarim", "pinyin", "sentido_funcional", "tipo"],
            "properties": {
              "funcao": {"type": "string", "minLength": 1},
              "mandarim": {"type": "string", "minLength": 1},
              "pinyin": {"type": "string", "minLength": 1},
              "sentido_funcional": {"type": "string", "minLength": 1},
              "tipo": {"enum": ["fixo", "substituivel", "particula", "operador", "base"]},
              "slot": {"type": "string"},
              "particula": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "sequencia": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}},
        "pacotes": {
          "type": "object",
          "required": ["essencial", "extensoes"],
          "properties": {
            "essencial": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "extensoes": {"type": "object", "additionalProperties": {"type": "boolean"}}
          },
          "additionalProperties": false
        },
        "proxima_unidade_sugerida": {"type": "string"},
        "audios": {
          "description": "Campo histórico opcional; não é lido nem gerado no fluxo PDF-first.",
          "deprecated": true,
          "type": "array"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
